# Host and port binding (keep 127.0.0.1 for local desktop usage)
TRACKER_HOST=127.0.0.1
TRACKER_PORT=8000

# Storage paths
TRACKER_DB_PATH=data/tracker.db
TRACKER_UPLOADS_DIR=data/uploads

# Background scheduler for periodic reminder checks (1 = enabled, 0 = disabled)
TRACKER_ENABLE_SCHEDULER=1
TRACKER_CHECK_INTERVAL_MINUTES=360

# Optional Telegram bot notifications
TRACKER_TELEGRAM_BOT_TOKEN=
TRACKER_TELEGRAM_CHAT_ID=
